{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailSettings": {
    "FromEmail": "noreply@innoclinic.com",
    "FromName": "InnoClinic Service",
    "WelcomeSubject": "Welcome to InnoClinic! Please verify your email.",
    "WelcomeBodyTemplate": "Hello! Click here to verify: <a href='{0}'>Verify Email</a>",
    "PollBodyTemplate": "<a href='{0}'>Ссилка</a>"
  },
  "ConnectionStrings": {
    "innoclinic-database": "Server=localhost;Port=5432;Database=NOT_A_REAL_DB",
    "mailpit": "Endpoint=http://localhost:1025"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "Endpoint": "http://localhost:4317",
          "Protocol": "Grpc"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}