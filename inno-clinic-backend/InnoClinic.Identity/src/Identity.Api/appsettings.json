{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "innoclinic-database": "Server=localhost;Port=5432;Database=NOT_A_REAL_DB",
        "mailpit": "Endpoint=http://localhost:1025"
    },
    "Jwt": {
        "Secret": "",
        "Issuer": "",
        "Audience": "",
        "ExpirationInMinutes": 0
    },
    "EmailSettings": {
        "FromEmail": "noreply@innoclinic.com",
        "FromName": "InnoClinic Service",
        "WelcomeSubject": "Welcome to InnoClinic! Please verify your email.",
        "WelcomeBodyTemplate": "Hello! Click here to verify: <a href='{0}'>Verify Email</a>"
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.Seq"
        ],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "Seq"
            },
            {
                "Name": "OpenTelemetry",
                "Args": {
                    "Endpoint": "http://localhost:4317",
                    "Protocol": "Grpc"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ]
    }
}